<%- include('partials/head', { pageTitle: code + ' Error' }) %>
<%- include('partials/nav') %>

<main class="page-main">
  <div class="container">
    <div class="error-page">
      <div class="error-code"><%= code %></div>
      <h1 class="error-message"><%= message %></h1>
      <p class="text-muted">The page you're looking for doesn't exist or you don't have permission to view it.</p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Go Home</a>
        <% if (user) { %><a href="/dashboard" class="btn btn-ghost">Dashboard</a><% } %>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
